# Universal Business Passport — environment variable NAMES only.
# Copy to .env and fill in values locally. NEVER commit .env.

# --- Required ---

# PostgreSQL connection string.
# Production: use a Neon *pooled* connection string (host contains "-pooler")
# because serverless functions open short-lived connections.
# Local: postgres://ubp:ubptest@127.0.0.1:55432/ubp_test
DATABASE_URL=

# --- Optional ---

# "production" enables Secure cookies and disables dev-only affordances.
NODE_ENV=development

# Absolute public origin used when generating QR codes, share links, CSRF
# checks and verification URLs. Required on any deployed environment, and must
# be https there. There is deliberately no fallback to the request Host header:
# that value is attacker-controlled and would let a caller steer generated links
# to a domain the operator did not configure. In local development only, an
# unset value falls back to http://localhost:5173.
PUBLIC_BASE_URL=

# Session cookie name. Defaults to "ubp_session".
SESSION_COOKIE_NAME=

# Email delivery transport for verification links.
#   none    (default) -> no email is sent; registration reports honestly that
#                        confirmation is unavailable, and no link is handed out
#   console           -> the verification link is written to the server log (dev only)
# No third-party email account is required for Phase 1.
EMAIL_TRANSPORT=none

# From address used when a real transport is configured. Name only, no secrets.
EMAIL_FROM=

# Which request header may be trusted to carry the real client IP, for rate
# limiting. Leave unset to trust no header (the socket address is used) — the
# correct choice anywhere without a known overwriting edge, because most proxies
# append to X-Forwarded-For rather than replacing it, so its first entry is
# attacker-controlled. Set automatically to x-vercel-forwarded-for when the
# VERCEL environment variable is present. Override only if you know your edge
# overwrites the header:
#   none                      -> never trust a header
#   x-vercel-forwarded-for    -> Vercel's platform-set header
#   x-forwarded-for           -> only when your own edge replaces the header
TRUSTED_IP_HEADER=

# --- Test-only ---

# Used by the automated test suite. Migrations are applied here and the schema
# is truncated between tests. Never point this at production data.
TEST_DATABASE_URL=

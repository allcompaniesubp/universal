# Universal Business Passport — environment variable NAMES only.
# Copy to .env and fill in values locally. NEVER commit .env.

# --- Required ---

# PostgreSQL connection string.
# Production: use a Neon *pooled* connection string (host contains "-pooler")
# because serverless functions open short-lived connections.
# Local: postgres://ubp:ubptest@127.0.0.1:55432/ubp_test
DATABASE_URL=

# --- Optional ---

# "production" enables Secure cookies and disables dev-only affordances.
NODE_ENV=development

# Absolute public origin used when generating QR codes, share links and
# verification URLs. If unset, the origin is derived from the request Host header.
PUBLIC_BASE_URL=

# Session cookie name. Defaults to "ubp_session".
SESSION_COOKIE_NAME=

# Email delivery transport for verification links.
#   none    (default) -> no email is sent; the UI states delivery is not configured
#   console           -> the verification link is written to the server log (dev only)
# No third-party email account is required for Phase 1.
EMAIL_TRANSPORT=none

# From address used when a real transport is configured. Name only, no secrets.
EMAIL_FROM=

# --- Test-only ---

# Used by the automated test suite. Migrations are applied here and the schema
# is truncated between tests. Never point this at production data.
TEST_DATABASE_URL=
